{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "devCommand": "npm run dev",
  "github": { "silent": false },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.brandonmicci.com"
        }
      ],
      "destination": "https://brandonmicci.com/:path*",
      "permanent": true
    }
  ]
}
