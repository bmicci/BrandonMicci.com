{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit": "npm run typecheck && npm run lint && npm run format:check",
    "lhci:server": "lhci autorun --collect.url=http://localhost:3000 --collect.startServerCommand=\"npm run start\" --collect.startServerReadyPattern=\"Ready in\" --upload.target=temporary-public-storage --assert.preset=lighthouse:recommended --assert.assertions.categories:performance=warn:0.90 --assert.assertions.categories:seo=warn:0.95 --budgetsPath=budgets.json"
  },
  "dependencies": {
    "@swc/helpers": "^0.5.2",
    "@vercel/analytics": "1.5.0",
    "@vercel/speed-insights": "1.2.0",
    "autoprefixer": "^10.4.21",
    "lucide-react": "0.544.0",
    "next": "16.2.10",
    "postcss": "^8.5.19",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@lhci/cli": "0.15.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "prettier": "^3.6.2",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "browserslist": {
    "production": [
      "defaults and supports es6-module",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version"
    ]
  }
}
